@startuml
title SVG Editor CLI — Phase 1
skinparam componentStyle rectangle
component "main.ts\ncomposition root" as main
package "cli" as cli_pkg {
  component "Repl / Tokenizer / CommandDispatcher" as cli
}
package "application" as app_pkg {
  component "EditorSession / Command / History\nports: DocumentStore" as app
}
package "domain" as domain_pkg {
  component "SvgDocument / Shape / Group\nGeometryShape / six concrete shapes / ShapeFactory" as domain
}
package "infrastructure" as infra_pkg {
  component "SvgCodec / SvgFileStore\nXML library / filesystem" as infra
}
main --> cli
main --> infra
cli --> app
app --> domain
infra --> app : implements port
infra --> domain
@enduml
